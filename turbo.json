{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEYS",
        "RESEND_API_KEY",
        "SUPABASE_PUBLISHABLE_publica",
        "SUPABASE_SECRET_secreta",
        "SUPABASE_SECRET_KEYS",
        "SUPABASE_URL",
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEYS",
        "RESEND_API_KEY",
        "SUPABASE_PUBLISHABLE_publica",
        "SUPABASE_SECRET_secreta",
        "SUPABASE_SECRET_KEYS",
        "SUPABASE_URL",
      ]
    }
  }
}
